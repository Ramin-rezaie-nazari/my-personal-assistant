generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(uuid())
  email String @unique
  passwordHash String?
  firstName String?
  lastName String?
  avatarUrl String?
  emailVerifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authAccounts AuthAccount[]
  sessions Session[]
  settings UserSettings?
  profile UserProfile?
  onboarding UserOnboarding?
  assistantProfile AssistantProfile?
  healthProfile HealthProfile?
  nutritionProfile NutritionProfile?
  dailyLogs DailyLog[]
  foods FoodItem[]
  meals Meal[]
  recipes Recipe[]
  inventoryItems InventoryItem[]
  shoppingLists ShoppingList[]
  goals Goal[]
  goalCheckins GoalCheckin[]
  calendarEvents CalendarEvent[]
  habits Habit[]
  habitLogs HabitLog[]
  workouts Workout[]
  reminders Reminder[]
  userBehaviors UserBehavior[]
  userInsights UserInsight[]
  notificationDevices NotificationDevice[]
}

model AuthAccount {
  id String @id @default(uuid())
  userId String
  provider String
  providerAccountId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id String @id @default(uuid())
  userId String
  refreshTokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id String @id @default(uuid())
  userId String @unique
  language String @default("en")
  timezone String @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserProfile {
  id String @id @default(uuid())
  userId String @unique
  age Int?
  gender String?
  heightCm Float?
  weightKg Float?
  activityLevel String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserOnboarding {
  id String @id @default(uuid())
  userId String @unique
  completed Boolean @default(false)
  step String?
  data Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AssistantProfile {
  id String @id @default(uuid())
  userId String @unique
  name String?
  personality String?
  preferences Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HealthProfile {
  id String @id @default(uuid())
  userId String @unique
  conditions Json?
  medications Json?
  allergies Json?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NutritionProfile {
  id String @id @default(uuid())
  userId String @unique
  calorieTarget Int?
  proteinTarget Float?
  carbsTarget Float?
  fatTarget Float?
  waterTargetMl Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyLog {
  id String @id @default(uuid())
  userId String
  dateKey String
  waterMl Int @default(0)
  calories Int @default(0)
  protein Float @default(0)
  carbs Float @default(0)
  fat Float @default(0)
  mood Int?
  energy Int?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, dateKey])
}

model FoodItem {
  id String @id @default(uuid())
  userId String?
  name String
  brand String?
  category String?
  calories Float @default(0)
  protein Float @default(0)
  carbs Float @default(0)
  fat Float @default(0)
  servingSize Float @default(100)
  servingUnit String @default("g")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  meals Meal[]
  recipeIngredients RecipeIngredient[]
}

model Meal {
  id String @id @default(uuid())
  userId String
  foodId String?
  name String
  calories Float @default(0)
  protein Float @default(0)
  carbs Float @default(0)
  fat Float @default(0)
  quantity Float @default(1)
  unit String @default("g")
  eatenAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  food FoodItem? @relation(fields: [foodId], references: [id], onDelete: SetNull)
  @@index([userId, eatenAt])
}

model Recipe {
  id String @id @default(uuid())
  userId String?
  name String
  description String?
  imageUrl String?
  imageSource String?
  servings Int @default(2)
  calories Int @default(0)
  protein Float @default(0)
  carbs Float @default(0)
  fat Float @default(0)
  verified Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]
}

model InventoryItem {
  id String @id @default(uuid())
  userId String
  name String
  quantity Float @default(0)
  unit String @default("g")
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ShoppingList {
  id String @id @default(uuid())
  userId String
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ShoppingListItem[]
}

model ShoppingListItem {
  id String @id @default(uuid())
  shoppingListId String
  name String
  quantity Float @default(1)
  unit String @default("item")
  checked Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shoppingList ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
}

model Goal {
  id String @id @default(uuid())
  userId String
  title String
  description String?
  targetValue Float?
  currentValue Float @default(0)
  unit String?
  status String @default("active")
  targetDateKey String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkins GoalCheckin[]
  @@index([userId, status])
}

model GoalCheckin {
  id String @id @default(uuid())
  userId String
  goalId String
  dateKey String
  value Float
  note String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  @@unique([goalId, dateKey])
  @@index([userId, dateKey])
}

model CalendarEvent {
  id String @id @default(uuid())
  userId String
  title String
  description String?
  startsAt DateTime
  endsAt DateTime?
  allDay Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, startsAt])
}

model Habit {
  id String @id @default(uuid())
  userId String
  name String
  frequency String @default("daily")
  targetCount Int @default(1)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]
  @@index([userId, active])
}

model HabitLog {
  id String @id @default(uuid())
  habitId String
  userId String
  dateKey String
  count Int @default(0)
  completed Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([habitId, dateKey])
  @@index([userId, dateKey])
}

model Workout {
  id String @id @default(uuid())
  userId String
  type String
  durationMinutes Int @default(0)
  caloriesBurned Int @default(0)
  performedAt DateTime
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, performedAt])
}

model Reminder {
  id String @id @default(uuid())
  userId String
  title String
  description String?
  remindAt DateTime
  repeatRule String?
  completed Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, remindAt])
}

model UserBehavior {
  id String @id @default(uuid())
  userId String
  type String
  value String?
  metadata Json?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model UserInsight {
  id String @id @default(uuid())
  userId String
  key String
  value Json
  generatedAt DateTime @default(now())
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, key])
  @@index([userId, generatedAt])
}

model NotificationDevice {
  id String @id @default(uuid())
  userId String
  expoPushToken String @unique
  platform String
  language String @default("en")
  timezone String @default("UTC")
  projectId String?
  enabled Boolean @default(true)
  lastSeenAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, enabled])
}

model RecipeIngredient {
  id String @id @default(uuid())
  recipeId String
  foodId String
  quantity Float @default(1)
  unit String @default("g")
  protein Float?
  carbs Float?
  fat Float?
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  food FoodItem @relation(fields: [foodId], references: [id], onDelete: Cascade)
  @@index([recipeId])
  @@index([foodId])
}
