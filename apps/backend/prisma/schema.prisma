generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())
  email String @unique
  passwordHash String?
  firstName String?
  lastName String?
  avatarUrl String?
  emailVerifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authAccounts AuthAccount[]
  sessions Session[]
  settings UserSettings?
  preferences UserPreference?
  profile UserProfile?
  onboarding UserOnboarding?
  assistantProfile AssistantProfile?
  healthProfile HealthProfile?
  nutritionProfile NutritionProfile?
  dailyLogs DailyLog[]
  nutritionLogs NutritionLog[]
  foodItems FoodItem[]
  meals Meal[]
  recipes Recipe[]
  inventoryItems InventoryItem[]
  shoppingItems ShoppingItem[]
  workouts Workout[]
  reminders Reminder[]
  habits Habit[]
  habitLogs HabitLog[]
  supplements Supplement[]
  supplementLogs SupplementLog[]
  notifications Notification[]
  userFacts UserFact[]
  userBehaviors UserBehavior[]
  userInsights UserInsight[]
  planExecutionStates PlanExecutionState[]
  fitnessProfileState FitnessProfileState?
  fitnessPlanAssignments FitnessPlanAssignment[]
  decisionAudits DecisionAuditEntry[]
  goals Goal[]
  conversationTurns ConversationTurn[]
  decisionOutcomes DecisionOutcome[]
  workoutPerformances WorkoutPerformance[]
}

model AuthAccount {
  id String @id @default(uuid())
  userId String
  provider String
  providerAccountId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id String @id @default(uuid())
  userId String
  refreshTokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings { id String @id @default(uuid()) userId String @unique user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model UserPreference { id String @id @default(uuid()) userId String @unique user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model UserProfile { id String @id @default(uuid()) userId String @unique user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model UserOnboarding { id String @id @default(uuid()) userId String @unique user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model AssistantProfile { id String @id @default(uuid()) userId String @unique user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model HealthProfile { id String @id @default(uuid()) userId String @unique user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model NutritionProfile { id String @id @default(uuid()) userId String @unique user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model DailyLog { id String @id @default(uuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model NutritionLog { id String @id @default(uuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model FoodItem { id String @id @default(uuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model Meal { id String @id @default(uuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model Recipe { id String @id @default(uuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model InventoryItem { id String @id @default(uuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model ShoppingItem { id String @id @default(uuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model Workout { id String @id @default(uuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model Reminder { id String @id @default(uuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model Habit { id String @id @default(uuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model HabitLog { id String @id @default(uuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model Supplement { id String @id @default(uuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model SupplementLog { id String @id @default(uuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model Notification { id String @id @default(uuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model UserFact { id String @id @default(uuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model UserBehavior { id String @id @default(uuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model UserInsight { id String @id @default(uuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model PlanExecutionState { id String @id @default(uuid()) userId String planId String status String stepIds Json completed Json blocked Json failed Json currentStep String? updatedAt DateTime @updatedAt user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@unique([userId,planId]) }
model FitnessProfileState { id String @id @default(uuid()) userId String @unique profile Json user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model DecisionAuditEntry { id String @id @default(uuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model Goal { id String @id @default(uuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model ConversationTurn { id String @id @default(uuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model DecisionOutcome { id String @id @default(uuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model WorkoutPerformance { id String @id @default(uuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
