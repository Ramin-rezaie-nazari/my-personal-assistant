generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())
  email String @unique
  passwordHash String?
  firstName String?
  lastName String?
  avatarUrl String?
  emailVerifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authAccounts AuthAccount[]
  sessions Session[]
  settings UserSettings?
  preferences UserPreference?
  profile UserProfile?
  onboarding UserOnboarding?
  assistantProfile AssistantProfile?
  healthProfile HealthProfile?
  nutritionProfile NutritionProfile?
  dailyLogs DailyLog[]
  nutritionLogs NutritionLog[]
  foodItems FoodItem[]
  meals Meal[]
  recipes Recipe[]
  inventoryItems InventoryItem[]
  shoppingItems ShoppingItem[]
  workouts Workout[]
  reminders Reminder[]
  habits Habit[]
  habitLogs HabitLog[]
  supplements Supplement[]
  supplementLogs SupplementLog[]
  notifications Notification[]
  userFacts UserFact[]
  userBehaviors UserBehavior[]
  userInsights UserInsight[]
  planExecutionStates PlanExecutionState[]
  fitnessProfileState FitnessProfileState?
  decisionAudits DecisionAuditEntry[]
  deviceHealthSnapshots DeviceHealthSnapshot[]
}

model AuthAccount {
  id String @id @default(uuid())
  userId String
  provider String
  providerAccountId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id String @id @default(uuid())
  userId String
  refreshToken String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id String @id @default(uuid())
  userId String @unique
  language String @default("en")
  timezone String @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreference {
  id String @id @default(uuid())
  userId String @unique
  onboardingCompleted Boolean @default(false)
  notificationsEnabled Boolean @default(true)
  reminderEnabled Boolean @default(true)
  theme String @default("system")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserProfile {
  id String @id @default(uuid())
  userId String @unique
  gender String?
  birthDate DateTime?
  heightCm Float?
  weightKg Float?
  primaryGoal String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserOnboarding {
  id String @id @default(uuid())
  userId String @unique
  completed Boolean @default(false)
  currentStep String @default("welcome")
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AssistantProfile {
  id String @id @default(uuid())
  userId String @unique
  healthGoal String?
  fitnessGoal String?
  nutritionGoal String?
  smokingHabit String?
  waterGoalMl Int?
  sleepGoalHours Float?
  exerciseGoal String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HealthProfile {
  id String @id @default(uuid())
  userId String @unique
  heightCm Int?
  weightKg Float?
  age Int?
  gender String?
  activityLevel String?
  targetWeightKg Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NutritionProfile {
  id String @id @default(uuid())
  userId String @unique
  dailyCaloriesGoal Int?
  proteinGoalGrams Int?
  waterGoalMl Int?
  dietType String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyLog {
  id String @id @default(uuid())
  userId String
  dateKey String
  waterMl Int @default(0)
  calories Int @default(0)
  protein Float @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, dateKey])
}

model NutritionLog {
  id String @id @default(uuid())
  userId String
  dateKey String
  mealType String
  title String
  calories Int @default(0)
  protein Float @default(0)
  carbs Float @default(0)
  fat Float @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, dateKey])
}

model DeviceHealthSnapshot {
  id String @id @default(uuid())
  userId String
  source String
  externalId String?
  startAt DateTime
  endAt DateTime
  steps Int?
  activeCalories Float?
  totalCalories Float?
  distanceMeters Float?
  sleepSeconds Int?
  heartRateAvg Float?
  workoutMinutes Float?
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, startAt, endAt])
  @@index([userId, source, updatedAt])
  @@unique([userId, source, externalId])
}

model IngredientCanonical {
  id String @id @default(uuid())
  canonicalKey String @unique
  canonicalName String
  scientificName String?
  foodGroup String?
  confidence Float @default(1)
  provenance String
  version String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  aliases IngredientCanonicalAlias[]
  foodItems FoodItem[]
  recipeIngredients RecipeIngredient[]
}

model IngredientCanonicalAlias {
  id String @id @default(uuid())
  canonicalIngredientId String
  normalizedAlias String
  displayAlias String
  provenance String
  version String
  createdAt DateTime @default(now())
  canonicalIngredient IngredientCanonical @relation(fields: [canonicalIngredientId], references: [id], onDelete: Cascade)
  @@unique([canonicalIngredientId, normalizedAlias])
  @@index([normalizedAlias])
}

model RegionCanonical {
  id String @id @default(uuid())
  countryCode String
  regionCode String
  canonicalName String
  provenance String
  version String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  recipes RecipeRegion[]
  @@unique([countryCode, regionCode])
  @@index([countryCode])
}

model CuisineCanonical {
  id String @id @default(uuid())
  canonicalKey String @unique
  canonicalName String
  parentCuisineId String?
  provenance String
  version String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  parentCuisine CuisineCanonical? @relation("CuisineHierarchy", fields: [parentCuisineId], references: [id], onDelete: SetNull)
  children CuisineCanonical[] @relation("CuisineHierarchy")
  recipes RecipeCuisine[]
  @@index([parentCuisineId])
}

model RecipeSafetyAssertion {
  id String @id @default(uuid())
  recipeId String
  assertionType String
  value String
  effect String
  confidence Float @default(0)
  provenance String
  verified Boolean @default(false)
  version String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  @@unique([recipeId, assertionType, value])
  @@index([assertionType, value, verified])
}
