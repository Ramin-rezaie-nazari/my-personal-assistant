{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "prebuild": "prisma generate",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "pretest": "prisma generate",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node ./test/prepare-e2e-db.cjs && jest --config ./test/jest-e2e.json --runInBand",
    "pretest:e2e": "prisma generate",
    "fitness:media:discover": "node ../../tools/discover-free-exercise-videos-commons.mjs ../../data/fitness-free-video-queries.sample.json ../../data/fitness-free-video-candidates.commons.json",
    "fitness:media:federated": "node ../../tools/discover-fitness-media-federated.mjs ../../data/fitness-free-video-queries.sample.json ../../data/fitness-media-source-inventory.seed.json ../../data/fitness-federated-video-candidates.json",
    "fitness:media:sources:1000": "node ../../tools/discover-fitness-1000-sources.mjs ../../data/fitness-media-source-inventory.seed.json ../../data/fitness-media-1000-source-discovery.generated.json",
    "fitness:media:sources:1000:search": "node ../../tools/discover-fitness-1000-sources-search.mjs ../../data/fitness-media-source-inventory.seed.json ../../data/fitness-media-1000-source-discovery.search.generated.json",
    "fitness:media:sources:merge": "node ../../tools/merge-fitness-source-discovery.mjs ../../data/fitness-media-source-inventory.seed.json ../../data/fitness-media-1000-source-discovery.search.generated.json ../../data/fitness-media-source-inventory.generated.json",
    "fitness:media:assets": "node ../../tools/discover-fitness-video-assets-from-sources.mjs ../../data/fitness-media-1000-source-discovery.search.generated.json ../../data/fitness-media-video-asset-candidates.generated.json ../../data/fitness-free-video-queries.sample.json",
    "fitness:media:review": "node ../../tools/review-fitness-video-rights.mjs ../../data/fitness-media-video-asset-candidates.generated.json ../../data/fitness-media-video-rights-review.generated.json",
    "fitness:media:coverage": "node ../../tools/summarize-fitness-media-coverage.mjs ../../data/fitness-media-video-rights-review.generated.json ../../data/fitness-free-video-queries.sample.json ../../data/fitness-media-coverage.generated.json",
    "fitness:media:canonical:build": "node ../../tools/build-fitness-canonical-1500.mjs",
    "fitness:media:queue:build": "node ../../tools/build-fitness-video-acquisition-queue.mjs",
    "fitness:media:1500": "node ../../tools/run-fitness-1500-video-pipeline.mjs",
    "fitness:media:1500:download": "node ../../tools/run-fitness-1500-video-pipeline.mjs --download",
    "fitness:media:next": "pnpm fitness:media:sources:merge && FITNESS_MEDIA_ASSET_CONCURRENCY=3 pnpm fitness:media:assets && FITNESS_MEDIA_RIGHTS_CONCURRENCY=3 pnpm fitness:media:review && pnpm fitness:media:coverage",
    "fitness:media:check": "node ../../tools/check-fitness-media-tools.mjs",
    "fitness:media:free": "node ../../tools/run-free-exercise-video-pipeline.mjs ../../data/fitness-free-video-queries.sample.json",
    "fitness:media:free:download": "node ../../tools/run-free-exercise-video-pipeline.mjs ../../data/fitness-free-video-queries.sample.json --download",
    "fitness:media:free:dry-run": "node ../../tools/run-free-exercise-video-pipeline.mjs ../../data/fitness-free-video-queries.sample.json --download --dry-run",
    "fitness:media:validate": "node ../../tools/validate-fitness-source-registry.mjs ../../data/fitness-source-registry.seed.json ../../data/fitness-approved-media.sample.json",
    "recipe-images:import": "node ./scripts/recipe-image-import.mjs",
    "recipe-images:dataset": "node ./scripts/recipe-image-dataset-import-v2.mjs",
    "recipe-images:reprocess-quality": "node ./scripts/recipe-image-reprocess-quality.mjs",
    "recipe-images:retry-quality": "node ./scripts/recipe-image-reprocess-retry.mjs",
    "recipe-intelligence:classify": "node ./scripts/recipe-intelligence-classify.mjs",
    "recipe-intelligence:profile": "node ./scripts/recipe-intelligence-profile.mjs",
    "recipe-intelligence:country": "node ./scripts/recipe-country-intelligence-final.mjs",
    "recipe-intelligence:ingredients": "node ./scripts/recipe-ingredient-intelligence.mjs",
    "recipe-intelligence:nutrition": "node ./scripts/recipe-nutrition-estimate.mjs",
    "recipe-intelligence:score": "node ./scripts/recipe-recommendation-score.mjs",
    "food-intelligence:self-test": "node ./scripts/food-intelligence-final-self-test.mjs",
    "recipe:content:import": "node ./scripts/recipe-content-import.mjs",
    "recipe:content:audit": "node ./scripts/recipe-content-audit.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.0",
    "dotenv": "^17.4.2",
    "joi": "^18.2.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.8.0",
    "jest": "30.4.1",
    "prettier": "^3.9.6",
    "source-map-support": "^0.5.21",
    "ts-jest": "29.4.12",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {"^.+\\.(t|j)s$": "ts-jest"},
    "moduleNameMapper": {"^(.+)\\.js$": "$1"},
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
