NODE_ENV=development
PORT=3000
APP_NAME=My Personal Assistant API
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/my_personal_assistant
JWT_ACCESS_SECRET=replace-with-a-long-random-development-secret
