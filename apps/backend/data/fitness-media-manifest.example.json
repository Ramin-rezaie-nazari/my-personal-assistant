{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MYPA Fitness Media Manifest",
  "type": "object",
  "required": ["exerciseSlug", "assets"],
  "properties": {
    "exerciseSlug": { "type": "string", "minLength": 1 },
    "contentVersion": { "type": "string", "minLength": 1 },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "format",
          "acquisitionMode",
          "sourceProvider",
          "sourceReference",
          "rightsBasis",
          "approvalStatus"
        ],
        "properties": {
          "role": {
            "enum": ["hero", "instructional_video", "secondary_video", "demo_image", "sequence_image"]
          },
          "format": { "enum": ["webp", "mp4", "webm", "mov"] },
          "acquisitionMode": {
            "enum": ["owned_upload", "licensed", "open_license", "external_authorized"]
          },
          "sourceProvider": { "type": "string", "minLength": 1 },
          "sourceReference": { "type": "string", "minLength": 1 },
          "creator": { "type": ["string", "null"] },
          "rightsBasis": { "type": "string", "minLength": 1 },
          "attribution": { "type": ["string", "null"] },
          "originalUrl": { "type": ["string", "null"], "format": "uri" },
          "storageKey": { "type": ["string", "null"] },
          "approvalStatus": { "enum": ["pending", "approved", "rejected"] },
          "transformed": { "type": "boolean" },
          "checksumSha256": { "type": ["string", "null"] },
          "durationMs": { "type": ["integer", "null"], "minimum": 0 },
          "width": { "type": ["integer", "null"], "minimum": 1 },
          "height": { "type": ["integer", "null"], "minimum": 1 },
          "language": { "type": ["string", "null"] }
        }
      }
    }
  }
}
