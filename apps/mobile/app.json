{
  "expo": {
    "name": "My Personal Assistant",
    "slug": "my-personal-assistant",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "mypersonalassistant",
    "splash": {
      "backgroundColor": "#070B1A",
      "resizeMode": "contain"
    },
    "backgroundColor": "#F7F8FA",
    "primaryColor": "#7C3AED",
    "android": {
      "package": "com.mypersonalassistant.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera for yoga coaching and movement analysis."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to use your microphone for voice conversations.",
          "speechRecognitionPermission": "Allow $(PRODUCT_NAME) to process your speech for voice recognition."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "827afeab-0faa-479d-9e17-fa70ca50dc27"
      }
    },
    "sdkVersion": "53.0.0",
    "platforms": [
      "ios",
      "android"
    ]
  }
}
