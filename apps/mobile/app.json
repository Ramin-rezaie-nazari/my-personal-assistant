{
  "expo": {
    "name": "My Personal Assistant",
    "slug": "my-personal-assistant",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "mypersonalassistant",
    "splash": {
      "backgroundColor": "#070B1A",
      "resizeMode": "contain"
    },
    "backgroundColor": "#F7F8FA",
    "primaryColor": "#7C3AED",
    "android": {
      "package": "com.mypersonalassistant.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "اجازه می‌دی دوربین فقط برای مربی یوگا و تحلیل حرکت استفاده بشه؟"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "اجازه می‌دی دستیار برای گفت‌وگوی صوتی به میکروفن دسترسی داشته باشه؟",
          "speechRecognitionPermission": "اجازه می‌دی دستیار صدات رو برای تشخیص گفتار پردازش کنه؟"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "827afeab-0faa-479d-9e17-fa70ca50dc27"
      }
    },
    "sdkVersion": "53.0.0",
    "platforms": [
      "ios",
      "android"
    ]
  }
}
